# ────────────────────────────────────────
# Environment Variables Template
# Copy this file as .env and fill in your values
# ────────────────────────────────────────

# ── Phase 1: Custom Backend ──
SECRET_KEY=your-secret-key-here
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/fossee_db

# ── Phase 2: Appwrite Backend ──
APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=YOUR_PROJECT_ID
APPWRITE_API_KEY=YOUR_API_KEY
APPWRITE_DATABASE_ID=YOUR_DATABASE_ID
APPWRITE_COLLECTION_ID=files
APPWRITE_BUCKET_ID=user-files
